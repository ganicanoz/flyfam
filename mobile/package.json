{
  "name": "flyfam-app",
  "version": "1.3.0",
  "main": "index.js",
  "scripts": {
    "test-api": "node scripts/test-flight-api.js",
    "start": "node scripts/start-metro-direct.js",
    "start:clear": "node scripts/start-metro-direct.js",
    "start:go": "node scripts/start-metro-direct.js",
    "start:expo": "expo start --clear",
    "android": "expo run:android",
    "ios": "expo start --ios --clear",
    "ios:run": "npx expo run:ios",
    "start:devclient": "EXPO_NO_TELEMETRY=1 npx expo start --dev-client --offline",
    "ios:devclient:auto": "node scripts/start-ios-devclient-auto.js",
    "web": "expo start --web",
    "ios:sim": "REACT_NATIVE_PACKAGER_HOSTNAME=127.0.0.1 npx expo start --ios --clear",
    "clean": "rm -rf node_modules/.cache .expo /tmp/metro-* /tmp/haste-* 2>/dev/null; echo 'Cache cleared. Run: npm run ios:sim'",
    "build:ios": "npx eas-cli@latest build --profile preview --platform ios --non-interactive",
    "build:ios:sim": "npx eas-cli@latest build --profile development --platform ios --non-interactive",
    "build:ios:store": "npx eas-cli@latest build --profile production --platform ios --non-interactive",
    "build:ios:store:submit": "npx eas-cli@latest build --profile production --platform ios --non-interactive && npx eas-cli@latest submit --platform ios --latest --profile production --non-interactive",
    "build:store:all": "npm run verify:android:icon && npx eas-cli@latest build --profile production --platform all --non-interactive",
    "submit:store:all": "npx eas-cli@latest submit --platform ios --latest --profile production --non-interactive && npx eas-cli@latest submit --platform android --latest --profile production --non-interactive",
    "build:android": "npx eas-cli@latest build --profile preview --platform android --non-interactive",
    "verify:android:icon": "python3 scripts/verify-android-launcher-icon.py",
    "build:android:store": "npm run verify:android:icon && npx eas-cli@latest build --profile production --platform android --non-interactive",
    "build:android:store:submit": "npx eas-cli@latest build --profile production --platform android --non-interactive && npx eas-cli@latest submit --platform android --latest --profile production --non-interactive",
    "check:android:local": "npx expo prebuild --platform android --clean && cd android && ./gradlew :app:assembleRelease",
    "submit:ios": "npx eas-cli@latest submit --platform ios --latest --profile production --non-interactive",
    "doctor": "expo-doctor",
    "pdf:roster": "tsx scripts/pdf-roster-preview.ts",
    "card:decision": "tsx scripts/flight-card-decision.ts",
    "card": "tsx scripts/flight-card-decision.ts",
    "roster:diagnose": "tsx scripts/diagnose-roster-flight.ts",
    "roster:status": "tsx scripts/roster-status-trace.ts",
    "roster:batch": "tsx scripts/roster-batch-table.ts"
  },
  "dependencies": {
    "@expo/plist": "^0.5.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/bottom-tabs": "^7.13.0",
    "@react-navigation/native": "^7.0.0",
    "@react-navigation/native-stack": "^7.0.0",
    "@supabase/supabase-js": "^2.45.0",
    "dotenv": "^17.3.1",
    "expo": "~54.0.0",
    "expo-asset": "~12.0.12",
    "expo-av": "~16.0.8",
    "expo-build-properties": "~1.0.10",
    "expo-clipboard": "^55.0.12",
    "expo-constants": "~18.0.13",
    "expo-device": "^8.0.10",
    "expo-document-picker": "~14.0.8",
    "expo-file-system": "~19.0.21",
    "expo-image-manipulator": "~14.0.8",
    "expo-image-picker": "~17.0.10",
    "expo-linear-gradient": "~15.0.8",
    "expo-linking": "~8.0.11",
    "expo-localization": "~17.0.8",
    "expo-notifications": "^0.32.16",
    "expo-pdf-text-extract": "^1.0.1",
    "expo-secure-store": "~15.0.8",
    "expo-share-extension": "^5.0.6",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.9",
    "i18next": "^25.8.13",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-i18next": "^16.5.4",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-iap": "^15.2.0",
    "react-native-maps": "1.20.1",
    "react-native-nitro-modules": "^0.35.6",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-web": "^0.21.0",
    "web-streams-polyfill": "^3.2.1"
  },
  "devDependencies": {
    "@babel/core": "^7.25.0",
    "@expo/ngrok": "^4.1.3",
    "@types/react": "~19.1.10",
    "pdf-parse": "^1.1.1",
    "tsx": "^4.19.2",
    "typescript": "~5.9.2"
  },
  "overrides": {
    "minimatch": "^10.2.1",
    "@expo/config-plugins": "~9.0.0",
    "@expo/prebuild-config": "~8.0.0"
  },
  "private": true
}
