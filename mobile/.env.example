# FlyFam — Environment Variables
# Copy to .env and fill in your values

# Supabase (from project Settings > API)
EXPO_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Supabase Service Role — Sadece backend/Edge Functions. Mobil .env'e ekleme.
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Flight lookup APIs (FR24 + AirLabs)
# Flightradar24 API — use quotes if token contains | or spaces
EXPO_PUBLIC_FLIGHTRADAR24_API_TOKEN="your-fr24-token"
# AirLabs — yarı aktif faz roster yenileme + Edge cron (yarı aktif)
# https://airlabs.co/
EXPO_PUBLIC_AIRLABS_API_KEY=your-airlabs-api-key
# AeroDataBox — API.Market birincil (RapidAPI kota dolunca SKIP_RAPIDAPI=1)
# Anahtar: https://apimarket.aerodatabox.com/ → x-magicapi-key
EXPO_PUBLIC_AERODATABOX_APIMARKET_KEY=your-x-magicapi-key
# Varsayılan gateway (değiştirmeyin gerek yoksa):
# EXPO_PUBLIC_AERODATABOX_APIMARKET_BASE=https://prod.api.market/api/v1/aedbx/aerodatabox
EXPO_PUBLIC_AERODATABOX_SKIP_RAPIDAPI=true
EXPO_PUBLIC_AERODATABOX_RAPIDAPI_KEY=your-adb-rapidapi-key
# FlightAPI — https://docs.flightapi.io/ (snapshot script; Edge’de FLIGHTAPI_API_KEY secret da olabilir)
# FLIGHTAPI_API_KEY=your-flightapi-key
# EXPO_PUBLIC_FLIGHTAPI_API_KEY=your-flightapi-key

# Aviation Stack — https://aviationstack.com/

# iOS promotional offer (App Store Connect → Promotional Offers → Reference Name)
# EXPO_PUBLIC_IOS_MONTHLY_PROMO_OFFER_ID=your_offer_reference_name

# Expo Push (optional — for sending pushes from backend)
# EXPO_ACCESS_TOKEN=your-expo-token
